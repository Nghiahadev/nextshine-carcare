<section class="ns-category-section">
  <div class="ns-category-container">
    <div class="ns-category-header">
      <p>{{ section.settings.subtitle }}</p>
      <h2>{{ section.settings.title }}</h2>
    </div>

    <div class="ns-card-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="ns-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 700 }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
            >
          {% endif %}

          <div class="ns-card-content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <span>Shop Now →</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
@property --a {
  syntax: "<angle>";
  initial-value: 45deg;
  inherits: true;
}

@property --r {
  syntax: "<angle>";
  initial-value: 5deg;
  inherits: true;
}

@property --p {
  syntax: "<percentage>";
  initial-value: 0%;
  inherits: true;
}

.ns-category-section {
  background: #050505;
  padding: 80px 20px;
}

.ns-category-container {
  max-width: 1200px;
  margin: 0 auto;
}

.ns-category-header {
  text-align: center;
  margin-bottom: 45px;
}

.ns-category-header p {
  color: #31d66b;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 14px;
  margin-bottom: 10px;
}

.ns-category-header h2 {
  color: #ffffff;
  font-size: clamp(32px, 5vw, 56px);
  margin: 0;
  font-weight: 800;
}

.ns-card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.ns-card {
  text-decoration: none;
  color: #fff;
  text-align: center;
}

.ns-card img {
  --c: #31d66b;
  --g: linear-gradient(#000 0 0);
  --_t: perspective(450px);

  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 28px;
  border: 4px solid #0000;
  padding: 10px;

  background:
    conic-gradient(from var(--a),
      #0000 calc(30% - var(--p)),
      var(--c) calc(50% - var(--p)) calc(50% + var(--p)),
      #0000 calc(70% + var(--p))) border-box;

  -webkit-mask:
    var(--g),
    var(--g) padding-box,
    conic-gradient(from var(--a),
      #000d calc(30% - var(--p)),
      #000 calc(50% - var(--p)) calc(50% + var(--p)),
      #000d calc(70% + var(--p))) content-box;

  -webkit-mask-composite: xor;
  mask-composite: exclude;

  animation: ns-a 4s linear infinite, ns-r 4s linear infinite;
  transition: --p .5s, --r .4s, transform .4s ease;
}

.ns-card:hover img {
  --p: 50%;
  --r: 0deg;
  animation-play-state: paused;
  transform: translateY(-8px) scale(1.03);
}

.ns-card-content {
  margin-top: 22px;
}

.ns-card-content h3 {
  color: #ffffff;
  font-size: 26px;
  margin: 0 0 10px;
  font-weight: 800;
}

.ns-card-content p {
  color: #b7b7b7;
  font-size: 15px;
  line-height: 1.6;
  margin: 0 0 14px;
}

.ns-card-content span {
  color: #31d66b;
  font-weight: 700;
  font-size: 15px;
}

@keyframes ns-a {
  to {
    --a: 405deg;
  }
}

@keyframes ns-r {
  0%, 100% {
    transform: var(--_t) rotate3d(1, 1, 0, var(--r));
  }
  12.5% {
    transform: var(--_t) rotate3d(0, 1, 0, var(--r));
  }
  25% {
    transform: var(--_t) rotate3d(-1, 1, 0, var(--r));
  }
  37.5% {
    transform: var(--_t) rotate3d(-1, 0, 0, var(--r));
  }
  50% {
    transform: var(--_t) rotate3d(-1, -1, 0, var(--r));
  }
  62.5% {
    transform: var(--_t) rotate3d(0, -1, 0, var(--r));
  }
  75% {
    transform: var(--_t) rotate3d(1, -1, 0, var(--r));
  }
  87.5% {
    transform: var(--_t) rotate3d(1, 0, 0, var(--r));
  }
}

@media (max-width: 900px) {
  .ns-card-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .ns-category-section {
    padding: 60px 18px;
  }

  .ns-card-content h3 {
    font-size: 24px;
  }
}
</style>

{% schema %}
{
  "name": "Next Shine Category Cards",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Small heading",
      "default": "Shop By Category"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main heading",
      "default": "Detail Every Part of Your Ride"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Interior"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Clean, refresh, and protect your car interior."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Next Shine Category Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Interior",
            "text": "Clean, refresh, and protect your car interior."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Exterior",
            "text": "Wash, foam, shine, and protect your paint."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Accessories",
            "text": "Tools and accessories every car lover needs."
          }
        }
      ]
    }
  ]
}
{% endschema %}