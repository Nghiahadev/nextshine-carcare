<section class="ns-category-section">
  <div class="ns-category-container">
    <div class="ns-category-header">
      <p>{{ section.settings.subtitle }}</p>
      <h2>{{ section.settings.title }}</h2>
    </div>

    <div class="ns-card-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="ns-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 700 }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
            >
          {% endif %}

          <div class="ns-card-content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <span>Shop Now →</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
/* ==========================
   NEXT SHINE CATEGORY CARDS
========================== */

@property --a {
  syntax: "<angle>";
  initial-value: 45deg;
  inherits: true;
}

@property --r {
  syntax: "<angle>";
  initial-value: 5deg;
  inherits: true;
}

@property --p {
  syntax: "<percentage>";
  initial-value: 0%;
  inherits: true;
}

.ns-category-section {
  background: #050505;
  padding: 60px 20px;
}

.ns-category-container {
  max-width: 1100px;
  margin: 0 auto;
}

.ns-category-header {
  text-align: center;
  margin-bottom: 40px;
}

.ns-category-header p {
  color: #31d66b;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 13px;
  margin-bottom: 8px;
}

.ns-category-header h2 {
  color: #ffffff;
  font-size: clamp(28px, 4vw, 48px);
  font-weight: 800;
  margin: 0;
}

/* ==========================
   CARD GRID
========================== */

.ns-card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.ns-card {
  text-decoration: none;
  text-align: center;
  color: #fff;
}

/* ==========================
   IMAGE EFFECT
========================== */

.ns-card img {
  --c: #31d66b;
  --g: linear-gradient(#000 0 0);
  --_t: perspective(450px);

  width: 100%;
  max-width: 240px;
  aspect-ratio: 1;
  object-fit: cover;

  border-radius: 22px;
  border: 3px solid transparent;
  padding: 8px;
  margin: 0 auto;

  background:
    conic-gradient(
      from var(--a),
      #0000 calc(30% - var(--p)),
      var(--c) calc(50% - var(--p))
      calc(50% + var(--p)),
      #0000 calc(70% + var(--p))
    ) border-box;

  -webkit-mask:
    var(--g),
    var(--g) padding-box,
    conic-gradient(
      from var(--a),
      #000d calc(30% - var(--p)),
      #000 calc(50% - var(--p))
      calc(50% + var(--p)),
      #000d calc(70% + var(--p))
    ) content-box;

  -webkit-mask-composite: xor;
  mask-composite: exclude;

  animation:
    ns-rotate-gradient 4s linear infinite,
    ns-rotate-card 4s linear infinite;

  transition:
    --p .5s,
    --r .4s,
    transform .4s ease;
}

.ns-card:hover img {
  --p: 50%;
  --r: 0deg;
  animation-play-state: paused;
  transform: translateY(-8px) scale(1.03);
}

/* ==========================
   TEXT
========================== */

.ns-card-content {
  margin-top: 16px;
}

.ns-card-content h3 {
  font-size: 24px;
  font-weight: 800;
  color: #fff;
  margin: 0 0 8px;
}

.ns-card-content p {
  color: #b8b8b8;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 10px;
}

.ns-card-content span {
  color: #31d66b;
  font-size: 14px;
  font-weight: 700;
}

/* ==========================
   ANIMATION
========================== */

@keyframes ns-rotate-gradient {
  to {
    --a: 405deg;
  }
}

@keyframes ns-rotate-card {
  0%,100% {
    transform: var(--_t) rotate3d(1,1,0,var(--r));
  }
  12.5% {
    transform: var(--_t) rotate3d(0,1,0,var(--r));
  }
  25% {
    transform: var(--_t) rotate3d(-1,1,0,var(--r));
  }
  37.5% {
    transform: var(--_t) rotate3d(-1,0,0,var(--r));
  }
  50% {
    transform: var(--_t) rotate3d(-1,-1,0,var(--r));
  }
  62.5% {
    transform: var(--_t) rotate3d(0,-1,0,var(--r));
  }
  75% {
    transform: var(--_t) rotate3d(1,-1,0,var(--r));
  }
  87.5% {
    transform: var(--_t) rotate3d(1,0,0,var(--r));
  }
}

/* ==========================
   TABLET
========================== */

@media screen and (max-width: 990px) {

  .ns-card-grid {
    gap: 16px;
  }

  .ns-card img {
    max-width: 180px;
  }

  .ns-card-content h3 {
    font-size: 18px;
  }

}

/* ==========================
   MOBILE
========================== */

@media screen and (max-width: 749px) {

  .ns-category-section {
    padding: 40px 10px;
  }

  .ns-category-header {
    margin-bottom: 25px;
  }

  .ns-category-header h2 {
    font-size: 24px;
  }

  .ns-card-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .ns-card img {
    max-width: 100%;
    padding: 4px;
    border-radius: 14px;
  }

  .ns-card-content {
    margin-top: 8px;
  }

  .ns-card-content h3 {
    font-size: 12px;
    margin-bottom: 0;
  }

  .ns-card-content p {
    display: none;
  }

  .ns-card-content span {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Next Shine Category Cards",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Small heading",
      "default": "Shop By Category"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main heading",
      "default": "Detail Every Part of Your Ride"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Interior"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Clean, refresh, and protect your car interior."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Next Shine Category Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Interior",
            "text": "Clean, refresh, and protect your car interior."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Exterior",
            "text": "Wash, foam, shine, and protect your paint."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Accessories",
            "text": "Tools and accessories every car lover needs."
          }
        }
      ]
    }
  ]
}
{% endschema %}