<section class="mystery-slot-section">
  <div class="mystery-slot-box">
    <p class="mystery-label">NEXTSHINE MYSTERY REWARD</p>

    <h2>Play the Mystery Box Slot</h2>

    <p class="mystery-text">
      Login to play once per day and unlock a surprise car care mystery reward.
    </p>

    <div class="slot-machine">
      <div class="slot-card">
        <svg viewBox="0 0 24 24">
          <path d="M3 10h18v11H3V10Z"/>
          <path d="M5 10V7h14v3"/>
          <path d="M12 7v14"/>
          <path d="M3 14h18"/>
          <path d="M8 7c-2-3 2-5 4 0"/>
          <path d="M16 7c2-3-2-5-4 0"/>
        </svg>
      </div>

      <div class="slot-card">
        <svg viewBox="0 0 24 24">
          <path d="M5 13l1.5-4.5A3 3 0 0 1 9.3 6h5.4a3 3 0 0 1 2.8 2.5L19 13"/>
          <path d="M4 13h16v5H4v-5Z"/>
          <path d="M7 18v2"/>
          <path d="M17 18v2"/>
          <circle cx="7.5" cy="15.5" r="1"/>
          <circle cx="16.5" cy="15.5" r="1"/>
        </svg>
      </div>

      <div class="slot-card">
        <svg viewBox="0 0 24 24">
          <path d="M9 3h6v5H9V3Z"/>
          <path d="M8 8h8l2 13H6L8 8Z"/>
          <path d="M10 12h4"/>
          <path d="M10 16h4"/>
        </svg>
      </div>
    </div>

    {% if customer %}
      <button class="mystery-btn" onclick="playMysterySlot()">
        Play Today
      </button>

      <p id="mystery-message" class="mystery-note">
        You can only play 1 time per day.
      </p>
    {% else %}
      <a href="{{ routes.account_login_url }}" class="mystery-btn">
        Login to Play
      </a>

      <p class="mystery-note">
        Login is required to play and unlock your mystery box.
      </p>
    {% endif %}
  </div>
</section>

<style>
.mystery-slot-section {
  padding: 80px 20px;
  background: #050505;
  color: #ffffff;
  text-align: center;
}

.mystery-slot-box {
  max-width: 950px;
  margin: 0 auto;
  padding: 55px 25px;
  border-radius: 30px;
  background:
    radial-gradient(circle at top, rgba(124,255,107,0.18), transparent 35%),
    linear-gradient(135deg, #101010, #181818);
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 25px 70px rgba(0,0,0,0.55);
}

.mystery-label {
  color: #7CFF6B;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 12px;
}

.mystery-slot-box h2 {
  font-size: clamp(34px, 5vw, 60px);
  line-height: 1.05;
  margin: 0 0 18px;
  font-weight: 900;
}

.mystery-text {
  max-width: 600px;
  margin: 0 auto 38px;
  color: #d8d8d8;
  font-size: 18px;
  line-height: 1.6;
}

.slot-machine {
  display: flex;
  justify-content: center;
  gap: 18px;
  margin-bottom: 36px;
}

.slot-card {
  width: 115px;
  height: 135px;
  border-radius: 20px;
  background: linear-gradient(180deg, #ffffff, #dcdcdc);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 0 -8px 0 rgba(0,0,0,0.15),
    0 12px 30px rgba(0,0,0,0.4);
}

.slot-card svg {
  width: 58px;
  height: 58px;
  stroke: #0b0b0b;
  stroke-width: 1.8;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mystery-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #7CFF6B;
  color: #050505;
  padding: 16px 42px;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 900;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: 0.25s ease;
}

.mystery-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(124,255,107,0.25);
}

.mystery-note {
  margin-top: 18px;
  color: #bdbdbd;
  font-size: 14px;
}

@media screen and (max-width: 600px) {
  .mystery-slot-section {
    padding: 55px 15px;
  }

  .slot-machine {
    gap: 10px;
  }

  .slot-card {
    width: 88px;
    height: 108px;
  }

  .slot-card svg {
    width: 44px;
    height: 44px;
  }
}
</style>

<script>
function playMysterySlot() {
  const today = new Date().toDateString();
  const lastPlay = localStorage.getItem("nextshine_mystery_play");
  const message = document.getElementById("mystery-message");

  if (lastPlay === today) {
    message.innerText = "You already played today. Come back tomorrow.";
    return;
  }

  localStorage.setItem("nextshine_mystery_play", today);

  const rewards = [
    "Mystery Box Reward",
    "Free Fragrance Sample",
    "Special Discount",
    "Bonus Car Care Item"
  ];

  const result = rewards[Math.floor(Math.random() * rewards.length)];

  message.innerText = "Congratulations! You unlocked: " + result;
}
</script>

{% schema %}
{
  "name": "Mystery Box Slot",
  "settings": [],
  "presets": [
    {
      "name": "Mystery Box Slot"
    }
  ]
}
{% endschema %}