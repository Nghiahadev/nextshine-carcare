<section class="mystery-slot-section">
  <div class="mystery-slot-box">
    <p class="mystery-label">NEXTSHINE MYSTERY REWARD</p>

    <h2>Play the Mystery Box Slot</h2>

    <p class="mystery-text">
      Login to play once per day and unlock a surprise car care mystery reward.
    </p>

    <div class="slot-machine">
      <div class="slot-card">
        <svg viewBox="0 0 24 24">
          <path d="M3 10h18v11H3V10Z"/>
          <path d="M5 10V7h14v3"/>
          <path d="M12 7v14"/>
          <path d="M3 14h18"/>
          <path d="M8 7c-2-3 2-5 4 0"/>
          <path d="M16 7c2-3-2-5-4 0"/>
        </svg>
      </div>

      <div class="slot-card">
        <svg viewBox="0 0 24 24">
          <path d="M5 13l1.5-4.5A3 3 0 0 1 9.3 6h5.4a3 3 0 0 1 2.8 2.5L19 13"/>
          <path d="M4 13h16v5H4v-5Z"/>
          <path d="M7 18v2"/>
          <path d="M17 18v2"/>
          <circle cx="7.5" cy="15.5" r="1"/>
          <circle cx="16.5" cy="15.5" r="1"/>
        </svg>
      </div>

      <div class="slot-card">
        <svg viewBox="0 0 24 24">
          <path d="M9 3h6v5H9V3Z"/>
          <path d="M8 8h8l2 13H6L8 8Z"/>
          <path d="M10 12h4"/>
          <path d="M10 16h4"/>
        </svg>
      </div>
    </div>

    {% if customer %}
      <button class="mystery-btn" onclick="playMysterySlot()">
        Play Today
      </button>

      <p id="mystery-message" class="mystery-note">
        You can only play 1 time per day.
      </p>
    {% else %}
      <a href="{{ routes.account_login_url }}" class="mystery-btn">
        Login to Play
      </a>

      <p class="mystery-note">
        Login is required to play and unlock your mystery box.
      </p>
    {% endif %}
  </div>
</section>

<style>
.mystery-slot-section {
  padding: 90px 20px;
  background: #f7f8f5;
  color: #111;
  text-align: center;
}

.mystery-slot-box {
  max-width: 1100px;
  margin: auto;
  padding: 60px 30px;
  border-radius: 36px;
  background: #ffffff;
  border: 1px solid #e7e7e7;
  box-shadow: 0 20px 60px rgba(0,0,0,0.08);
}

.mystery-label {
  display: inline-block;
  background: #e9ffe6;
  color: #1f7a2e;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.5px;
  margin-bottom: 18px;
}

.mystery-slot-box h2 {
  font-size: clamp(36px, 5vw, 64px);
  line-height: 1;
  margin: 0 0 18px;
  font-weight: 900;
  letter-spacing: -1px;
}

.mystery-text {
  max-width: 620px;
  margin: 0 auto 40px;
  color: #555;
  font-size: 18px;
  line-height: 1.6;
}

.slot-machine {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  max-width: 520px;
  margin: 0 auto 38px;
  padding: 18px;
  background: #101010;
  border-radius: 28px;
}

.slot-card {
  height: 135px;
  border-radius: 22px;
  background: linear-gradient(180deg, #ffffff, #eeeeee);
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-card svg {
  width: 54px;
  height: 54px;
  stroke: #111;
  stroke-width: 1.8;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mystery-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #111;
  color: #fff;
  padding: 16px 44px;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 900;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: 0.25s ease;
}

.mystery-btn:hover {
  background: #1f7a2e;
  transform: translateY(-2px);
}

.mystery-note {
  margin-top: 18px;
  color: #777;
  font-size: 14px;
}

@media screen and (max-width: 600px) {
  .mystery-slot-section {
    padding: 60px 15px;
  }

  .mystery-slot-box {
    padding: 45px 18px;
    border-radius: 26px;
  }

  .slot-machine {
    gap: 10px;
    padding: 12px;
  }

  .slot-card {
    height: 100px;
  }

  .slot-card svg {
    width: 40px;
    height: 40px;
  }
}
</style>

<script>
function playMysterySlot() {
  const today = new Date().toDateString();
  const lastPlay = localStorage.getItem("nextshine_mystery_play");
  const message = document.getElementById("mystery-message");

  if (lastPlay === today) {
    message.innerText = "You already played today. Come back tomorrow.";
    return;
  }

  localStorage.setItem("nextshine_mystery_play", today);

  const rewards = [
    "Mystery Box Reward",
    "Free Fragrance Sample",
    "Special Discount",
    "Bonus Car Care Item"
  ];

  const result = rewards[Math.floor(Math.random() * rewards.length)];

  message.innerText = "Congratulations! You unlocked: " + result;
}
</script>

{% schema %}
{
  "name": "Mystery Box Slot",
  "settings": [],
  "presets": [
    {
      "name": "Mystery Box Slot"
    }
  ]
}
{% endschema %}