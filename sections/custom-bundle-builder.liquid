<section class="bundle-builder">
  <div class="bundle-header">
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.subtitle }}</p>
  </div>

  <div class="bundle-layout">
    <div class="bundle-left">
      <div class="bundle-tabs">
        {% for block in section.blocks %}
          <button class="bundle-tab {% if forloop.first %}active{% endif %}" data-step="{{ forloop.index }}">
            Step {{ forloop.index }}
          </button>
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        <div class="bundle-step {% if forloop.first %}active{% endif %}" data-step="{{ forloop.index }}">
          <h2>{{ block.settings.heading }}</h2>
          <p>{{ block.settings.text }}</p>

          <div class="bundle-products">
            {% assign col = block.settings.collection %}
            {% if col != blank %}
              {% for product in col.products limit: 12 %}
                {% assign variant = product.selected_or_first_available_variant %}
                <div class="bundle-product">
                  <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
                  <h3>{{ product.title }}</h3>
                  <p>{{ product.price | money }}</p>

                  <button 
                    class="add-step-product"
                    data-step="{{ forloop.parentloop.index }}"
                    data-id="{{ variant.id }}"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ product.price }}"
                    data-image="{{ product.featured_image | image_url: width: 120 }}">
                    Add to bundle
                  </button>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="bundle-sidebar">
      <h2>Your bundle</h2>
      <p>Choose one product for each step.</p>

      <div class="selected-items">
        {% for block in section.blocks %}
          <div class="selected-box" data-selected-step="{{ forloop.index }}">
            <strong>Step {{ forloop.index }}</strong>
            <div class="selected-content">Add product to this step</div>
          </div>
        {% endfor %}
      </div>

      <div class="bundle-total">
        <span>Total bundle price:</span>
        <strong id="bundle-total-price">$0.00</strong>
      </div>

      <button id="add-bundle-cart" disabled>Add bundle to cart</button>
      <p id="bundle-message"></p>
    </div>
  </div>
</section>

<style>
.bundle-builder {
  max-width: 1250px;
  margin: auto;
  padding: 50px 20px;
}

.bundle-header {
  text-align: center;
  margin-bottom: 25px;
}

.bundle-header h1 {
  font-size: 34px;
  margin: 0;
}

.bundle-layout {
  display: grid;
  grid-template-columns: 1fr 330px;
  gap: 25px;
  align-items: start;
}

.bundle-tabs {
  display: flex;
  gap: 8px;
  background: #f1f1f1;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 20px;
}

.bundle-tab {
  border: 0;
  padding: 10px 18px;
  background: #ddd;
  cursor: pointer;
  border-radius: 6px;
  font-weight: 700;
}

.bundle-tab.active {
  background: #111;
  color: white;
}

.bundle-step {
  display: none;
}

.bundle-step.active {
  display: block;
}

.bundle-products {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  margin-top: 25px;
}

.bundle-product {
  text-align: left;
}

.bundle-product img {
  width: 100%;
  height: 220px;
  object-fit: contain;
}

.bundle-product h3 {
  font-size: 14px;
  min-height: 40px;
  margin: 10px 0 5px;
  text-transform: uppercase;
}

.bundle-product p {
  margin: 0 0 10px;
}

.add-step-product {
  width: 100%;
  background: #222;
  color: white;
  border: 0;
  padding: 12px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 700;
}

.add-step-product:hover {
  background: #000;
}

.bundle-sidebar {
  position: sticky;
  top: 120px;
  background: #f4f4f4;
  padding: 18px;
  border-radius: 10px;
}

.bundle-sidebar h2 {
  margin: 0;
}

.selected-box {
  background: white;
  border: 1px dashed #ccc;
  border-radius: 8px;
  padding: 12px;
  margin: 12px 0;
}

.selected-content {
  margin-top: 8px;
  color: #777;
}

.selected-product {
  display: flex;
  gap: 10px;
  align-items: center;
}

.selected-product img {
  width: 55px;
  height: 55px;
  object-fit: contain;
}

.remove-selected {
  margin-left: auto;
  border: 0;
  background: transparent;
  font-size: 18px;
  cursor: pointer;
}

.bundle-total {
  display: flex;
  justify-content: space-between;
  margin: 18px 0;
  font-size: 15px;
}

#add-bundle-cart {
  width: 100%;
  background: #111;
  color: white;
  border: 0;
  padding: 14px;
  border-radius: 6px;
  font-weight: 800;
  cursor: pointer;
}

#add-bundle-cart:disabled {
  background: #aaa;
  cursor: not-allowed;
}

@media(max-width: 900px) {
  .bundle-layout {
    grid-template-columns: 1fr;
  }

  .bundle-products {
    grid-template-columns: repeat(2, 1fr);
  }

  .bundle-sidebar {
    position: static;
  }
}

@media(max-width: 600px) {
  .bundle-products {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  let selected = {};

  const tabs = document.querySelectorAll(".bundle-tab");
  const steps = document.querySelectorAll(".bundle-step");
  const addButtons = document.querySelectorAll(".add-step-product");
  const cartBtn = document.getElementById("add-bundle-cart");
  const totalEl = document.getElementById("bundle-total-price");
  const message = document.getElementById("bundle-message");

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      const step = tab.dataset.step;

      tabs.forEach(t => t.classList.remove("active"));
      steps.forEach(s => s.classList.remove("active"));

      tab.classList.add("active");
      document.querySelector('.bundle-step[data-step="' + step + '"]').classList.add("active");
    });
  });

  addButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      const step = btn.dataset.step;

      selected[step] = {
        id: Number(btn.dataset.id),
        title: btn.dataset.title,
        price: Number(btn.dataset.price),
        image: btn.dataset.image
      };

      updateSidebar();

      const nextTab = document.querySelector('.bundle-tab[data-step="' + (Number(step) + 1) + '"]');
      if (nextTab) nextTab.click();
    });
  });

  function updateSidebar() {
    let total = 0;

    document.querySelectorAll(".selected-box").forEach(box => {
      const step = box.dataset.selectedStep;
      const content = box.querySelector(".selected-content");

      if (selected[step]) {
        total += selected[step].price;

        content.innerHTML = `
          <div class="selected-product">
            <img src="${selected[step].image}">
            <div>
              <strong>${selected[step].title}</strong><br>
              $${(selected[step].price / 100).toFixed(2)}
            </div>
            <button class="remove-selected" data-remove="${step}">×</button>
          </div>
        `;
      } else {
        content.innerHTML = "Add product to this step";
      }
    });

    totalEl.innerText = "$" + (total / 100).toFixed(2);

    const requiredSteps = document.querySelectorAll(".bundle-step").length;
    cartBtn.disabled = Object.keys(selected).length !== requiredSteps;

    document.querySelectorAll(".remove-selected").forEach(btn => {
      btn.addEventListener("click", () => {
        delete selected[btn.dataset.remove];
        updateSidebar();
      });
    });
  }

  cartBtn.addEventListener("click", () => {
    const items = Object.values(selected).map(item => ({
      id: item.id,
      quantity: 1
    }));

    fetch("/cart/add.js", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ items: items })
    })
    .then(res => res.json())
    .then(() => {
      window.location.href = "/cart";
    })
    .catch(() => {
      message.innerText = "Something went wrong.";
      message.style.color = "red";
    });
  });
});
</script>

{% schema %}
{
  "name": "Bundle Builder",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Build Your Own Bundle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Select items for your own bundle and save."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Bundle Step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Step heading",
          "default": "Exterior Products"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Step text",
          "default": "Choose your products"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Step collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}