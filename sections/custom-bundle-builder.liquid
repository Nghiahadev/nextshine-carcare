<section class="bundle-builder">
  <div class="bundle-header">
    <h1>Build Your Own Bundle</h1>
    <p>Select items for your own bundle and save up to 30% off!</p>
  </div>

  <div class="bundle-layout">
    <div class="bundle-products">
      <div class="bundle-steps">
        <span class="active">Step 1</span>
        <span>Step 2</span>
        <span>Step 3</span>
      </div>

      <h2>Exterior Products</h2>
      <p>Choose Your Exterior Products</p>

      <div class="product-grid">
        {% for product in collections['all'].products limit: 8 %}
          <div class="bundle-card">
            <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
            <h3>{{ product.title }}</h3>
            <p>{{ product.price | money }}</p>
            <button 
              class="add-bundle-btn"
              data-title="{{ product.title }}"
              data-price="{{ product.price | money }}"
              data-image="{{ product.featured_image | image_url: width: 100 }}"
            >
              Add to bundle
            </button>
            <a href="{{ product.url }}">See more</a>
          </div>
        {% endfor %}
      </div>
    </div>

    <aside class="bundle-sidebar">
      <h2>Your bundle</h2>
      <p>Choose items from this page to make your own bundle.</p>

      <div class="bundle-progress">
        <div>
          <span></span>
          <p>Pick 2 get 10% off</p>
        </div>
        <div>
          <span></span>
          <p>Pick 4 get 20% off</p>
        </div>
        <div>
          <span></span>
          <p>Pick 5 get 30% off</p>
        </div>
      </div>

      <div id="bundleItems"></div>

      <div class="bundle-total">
        <strong>Total bundle price:</strong>
        <span id="bundleTotal">$0.00</span>
      </div>

      <button class="bundle-cart-btn">Add bundle to cart</button>
    </aside>
  </div>
</section>

<style>
.bundle-builder {
  padding: 40px 5%;
  background: #fff;
  color: #111;
}

.bundle-header {
  text-align: center;
  margin-bottom: 30px;
}

.bundle-header h1 {
  font-size: 32px;
  font-weight: 800;
}

.bundle-layout {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 30px;
  align-items: start;
}

.bundle-steps {
  display: flex;
  gap: 8px;
  background: #f2f2f2;
  padding: 10px;
  margin-bottom: 20px;
}

.bundle-steps span {
  background: #333;
  color: #fff;
  padding: 8px 14px;
  font-size: 13px;
  border-radius: 4px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 35px 25px;
}

.bundle-card img {
  width: 100%;
  height: 220px;
  object-fit: contain;
}

.bundle-card h3 {
  font-size: 14px;
  font-weight: 800;
  min-height: 42px;
}

.bundle-card p {
  font-size: 14px;
  margin: 6px 0;
}

.add-bundle-btn,
.bundle-cart-btn {
  width: 100%;
  background: #222;
  color: #fff;
  border: none;
  padding: 12px;
  border-radius: 6px;
  font-weight: 700;
  cursor: pointer;
}

.add-bundle-btn:hover,
.bundle-cart-btn:hover {
  background: #000;
}

.bundle-card a {
  display: inline-block;
  margin-top: 10px;
  color: #555;
  font-size: 13px;
  text-decoration: underline;
}

.bundle-sidebar {
  position: sticky;
  top: 100px;
  background: #f5f5f5;
  padding: 20px;
  border-radius: 10px;
}

.bundle-sidebar h2 {
  margin-bottom: 5px;
}

.bundle-progress {
  display: flex;
  justify-content: space-between;
  text-align: center;
  margin: 20px 0;
  gap: 8px;
}

.bundle-progress span {
  display: block;
  width: 12px;
  height: 12px;
  background: #111;
  border-radius: 50%;
  margin: 0 auto 6px;
}

.bundle-progress p {
  font-size: 11px;
}

.bundle-item {
  display: flex;
  gap: 10px;
  background: #fff;
  padding: 10px;
  border-radius: 6px;
  margin-bottom: 10px;
}

.bundle-item img {
  width: 45px;
  height: 45px;
  object-fit: contain;
}

.bundle-total {
  display: flex;
  justify-content: space-between;
  margin: 20px 0;
  font-size: 15px;
}

@media (max-width: 900px) {
  .bundle-layout {
    grid-template-columns: 1fr;
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .bundle-sidebar {
    position: static;
  }
}

@media (max-width: 600px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const buttons = document.querySelectorAll(".add-bundle-btn");
  const bundleItems = document.getElementById("bundleItems");

  buttons.forEach(button => {
    button.addEventListener("click", function () {
      const title = this.dataset.title;
      const price = this.dataset.price;
      const image = this.dataset.image;

      const item = document.createElement("div");
      item.classList.add("bundle-item");

      item.innerHTML = `
        <img src="${image}" alt="${title}">
        <div>
          <strong>${title}</strong>
          <p>${price}</p>
        </div>
      `;

      bundleItems.appendChild(item);
    });
  });
});
</script>

{% schema %}
{
  "name": "Custom Bundle Builder",
  "settings": [],
  "presets": [
    {
      "name": "Custom Bundle Builder"
    }
  ]
}
{% endschema %}